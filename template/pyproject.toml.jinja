[project]
name = "{{ project_name_snake }}"
version = "0.1.0"
description = "{{ project_description }}"
readme = "README.md"
license = "MIT"
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" }
]
requires-python = ">=3.13"
dependencies = []

[dependency-groups]
dev = [
    "pytest>=8",
    "ruff>=0.12",
]

[build-system]
requires = ["uv_build>=0.13.5,<0.14.0"]
build-backend = "uv_build"

[tool.ruff]
target-version = "py313"
line-length = 100

[tool.ruff.lint]
select = ["E", "F", "I", "UP", "B", "SIM", "N"]

[tool.pytest.ini_options]
testpaths = ["tests"]
# Tests marked gpu need a GPU, model weights or the network; run them with `-m gpu`.
addopts = "-m 'not gpu'"
markers = ["gpu: needs a GPU, model weights or the network"]
