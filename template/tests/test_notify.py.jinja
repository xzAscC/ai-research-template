@pytest.fixture(autouse=True)
def _clean_env(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    for key in notify.DOTENV_KEYS:
        monkeypatch.delenv(key, raising=False)
    # isolate from the developer's real .env at the repo root
    monkeypatch.setattr(notify, "_dotenv_path", lambda: tmp_path / "absent.env")


@pytest.fixture
def fake_smtp(monkeypatch: pytest.MonkeyPatch) -> type:
    instances: list[object] = []

    class FakeSMTP:
        send_error: Exception | None = None
        quit_error: Exception | None = None

        def __init__(self, host: str, port: int, timeout: float | None = None) -> None:
            self.host = host
            self.port = port
            self.ops: list[tuple[object, ...]] = []
            self.sent: list[object] = []
            instances.append(self)

        def quit(self) -> None:
            self.ops.append(("quit",))
            if self.quit_error is not None:
                raise self.quit_error

        def close(self) -> None:
            self.ops.append(("close",))

        def starttls(self, context: object | None = None) -> None:
            self.ops.append(("starttls",))

        def login(self, user: str, password: str) -> None:
            self.ops.append(("login", user, password))

        def send_message(self, msg: object) -> None:
            if self.send_error is not None:
                raise self.send_error
            self.sent.append(msg)

    monkeypatch.setattr(smtplib, "SMTP", FakeSMTP)
    FakeSMTP.instances = instances  # type: ignore[attr-defined]
    return FakeSMTP


def _set_creds(monkeypatch: pytest.MonkeyPatch, password: str = "abcdefghijklmnop") -> None:
    monkeypatch.setenv("NOTIFY_GMAIL_USER", "sender@gmail.com")
    monkeypatch.setenv("NOTIFY_GMAIL_APP_PASSWORD", password)


def _write_env(path: Path, text: str) -> Path:
    # explicit mode, so the tests do not depend on the umask (002 makes files group-writable)
    path.write_text(text, encoding="utf-8")
    path.chmod(0o600)
    return path


# --- .env -------------------------------------------------------------------


def test_load_dotenv_parses_keys_quotes_and_comments(tmp_path: Path) -> None:
    env = _write_env(
        tmp_path / ".env",
        "# comment line\n"
        "NOTIFY_GMAIL_USER=sender@gmail.com\n"
        'NOTIFY_GMAIL_APP_PASSWORD="abcd efgh ijkl mnop"\n'
        "\n"
        "IGNORED_NO_EQUALS_LINE\n"
        "NOTIFY_TO='a@x.com, b@y.com'\n",
    )
    assert notify._load_dotenv(env) == {
        "NOTIFY_GMAIL_USER": "sender@gmail.com",
        "NOTIFY_GMAIL_APP_PASSWORD": "abcd efgh ijkl mnop",
        "NOTIFY_TO": "a@x.com, b@y.com",
    }


def test_load_dotenv_ignores_other_keys(tmp_path: Path) -> None:
    env = _write_env(
        tmp_path / ".env",
        "NOTIFY_GMAIL_USER=sender@gmail.com\nLD_PRELOAD=/tmp/evil.so\nPYTHONPATH=/tmp/evil\n",
    )
    assert notify._load_dotenv(env) == {"NOTIFY_GMAIL_USER": "sender@gmail.com"}


@pytest.mark.parametrize("kind", ["group-writable", "world-writable", "symlink"])
def test_load_dotenv_rejects_unsafe_file_with_a_warning(
    tmp_path: Path, kind: str, capsys: pytest.CaptureFixture[str]
) -> None:
    target = _write_env(tmp_path / "real.env", "NOTIFY_GMAIL_USER=sender@gmail.com\n")
    if kind == "symlink":
        env = tmp_path / ".env"
        env.symlink_to(target)
    else:
        target.chmod(0o620 if kind == "group-writable" else 0o602)
        env = target
    assert notify._load_dotenv(env) == {}
    assert "chmod 600" in capsys.readouterr().err


def test_load_dotenv_missing_file_returns_empty(
    tmp_path: Path, capsys: pytest.CaptureFixture[str]
) -> None:
    assert notify._load_dotenv(tmp_path / "nope.env") == {}
    assert capsys.readouterr().err == ""


def test_real_environment_wins_over_dotenv(monkeypatch: pytest.MonkeyPatch, tmp_path: Path) -> None:
    env = _write_env(tmp_path / ".env", "NOTIFY_GMAIL_USER=dot@gmail.com\nNOTIFY_TO=dot@x.com\n")
    monkeypatch.setattr(notify, "_dotenv_path", lambda: env)
    monkeypatch.setenv("NOTIFY_GMAIL_USER", "real@gmail.com")
    settings = notify._settings()
    assert settings["NOTIFY_GMAIL_USER"] == "real@gmail.com"
    assert settings["NOTIFY_TO"] == "dot@x.com"
    # .env is never copied into the environment
    assert "NOTIFY_TO" not in os.environ


