# --- send_email -------------------------------------------------------------


def test_send_email_smtp_flow_and_headers(fake_smtp: type, monkeypatch: pytest.MonkeyPatch) -> None:
    _set_creds(monkeypatch, password="abcd efgh ijkl mnop")
    monkeypatch.setenv("NOTIFY_TO", "rcpt@x.com")
    notify.send_email("hello subject", "hello body")
    (inst,) = fake_smtp.instances  # type: ignore[attr-defined]
    assert (inst.host, inst.port) == ("smtp.gmail.com", 587)
    ops = [op[0] for op in inst.ops]
    assert ops.index("starttls") < ops.index("login")
    # spaces in the app password are removed
    assert ("login", "sender@gmail.com", "abcdefghijklmnop") in inst.ops
    (msg,) = inst.sent
    assert msg["From"] == "sender@gmail.com"
    assert msg["To"] == "rcpt@x.com"
    assert msg["Subject"] == "hello subject"
    assert "hello body" in msg.get_content()


def test_send_email_requires_configuration() -> None:
    with pytest.raises(RuntimeError, match="NOTIFY_GMAIL_USER"):
        notify.send_email("s", "b")


def test_send_email_failure_after_sending_is_ambiguous(
    fake_smtp: type, monkeypatch: pytest.MonkeyPatch
) -> None:
    _set_creds(monkeypatch)
    fake_smtp.fail_on_send = True  # type: ignore[attr-defined]
    with pytest.raises(notify.AmbiguousDeliveryError):
        notify.send_email("s", "b")


# --- notify_on_exit ---------------------------------------------------------


def test_notify_on_exit_success_sends_one_email(
    fake_smtp: type, monkeypatch: pytest.MonkeyPatch
) -> None:
    _set_creds(monkeypatch)
    with notify.notify_on_exit("exp1"):
        pass
    (inst,) = fake_smtp.instances  # type: ignore[attr-defined]
    (msg,) = inst.sent
    assert msg["Subject"] == "[{{ project_name_snake }}] done: exp1"
    body = msg.get_content()
    assert "status: completed" in body
    assert socket.gethostname() in body


def test_notify_on_exit_failure_sends_traceback_and_reraises(
    fake_smtp: type, monkeypatch: pytest.MonkeyPatch
) -> None:
    _set_creds(monkeypatch)
    with pytest.raises(RuntimeError, match="boom"), notify.notify_on_exit("exp1"):
        raise RuntimeError("boom")
    (inst,) = fake_smtp.instances  # type: ignore[attr-defined]
    (msg,) = inst.sent
    assert msg["Subject"] == "[{{ project_name_snake }}] FAILED: exp1"
    body = msg.get_content()
    assert "Traceback" in body
    assert "RuntimeError: boom" in body


def test_notify_on_exit_includes_log_tail(
    fake_smtp: type, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
) -> None:
    _set_creds(monkeypatch)
    log = tmp_path / "run.log"
    log.write_text("\n".join(f"line{i}" for i in range(100)), encoding="utf-8")
    with (
        pytest.raises(ValueError),
        notify.notify_on_exit("exp", log_file=log, tail_lines=10),
    ):
        raise ValueError("x")
    (inst,) = fake_smtp.instances  # type: ignore[attr-defined]
    body = inst.sent[0].get_content()
    assert "line99" in body and "line90" in body
    assert "line89" not in body


def test_notify_on_exit_unconfigured_sends_nothing(fake_smtp: type) -> None:
    with notify.notify_on_exit("exp"):
        pass
    with pytest.raises(RuntimeError, match="boom"), notify.notify_on_exit("exp"):
        raise RuntimeError("boom")
    assert fake_smtp.instances == []  # type: ignore[attr-defined]


def test_notify_on_exit_send_failure_never_stops_the_run(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    _set_creds(monkeypatch)

    def broken(*args: object, **kwargs: object) -> None:
        raise OSError("smtp down")

    monkeypatch.setattr(notify, "send_email", broken)
    with notify.notify_on_exit("exp"):
        pass


def test_notify_on_exit_disabled_sends_nothing(
    fake_smtp: type, monkeypatch: pytest.MonkeyPatch
) -> None:
    _set_creds(monkeypatch)
    with notify.notify_on_exit("exp", enabled=False):
        pass
    with pytest.raises(RuntimeError, match="boom"), notify.notify_on_exit("exp", enabled=False):
        raise RuntimeError("boom")
    assert fake_smtp.instances == []  # type: ignore[attr-defined]
