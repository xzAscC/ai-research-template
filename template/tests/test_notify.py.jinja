def test_notify_on_exit_runs_the_block_when_dotenv_is_unreadable(
    fake_smtp: type,
    monkeypatch: pytest.MonkeyPatch,
    tmp_path: Path,
    capsys: pytest.CaptureFixture[str],
) -> None:
    env = tmp_path / ".env"
    env.write_bytes("NOTIFY_GMAIL_USER=a@b.c\n".encode("utf-16"))  # e.g. saved by PowerShell
    env.chmod(0o600)
    monkeypatch.setattr(notify, "_dotenv_path", lambda: env)
    ran = False
    with notify.notify_on_exit("exp"):
        ran = True
    assert ran
    assert "cannot read" in capsys.readouterr().err


def test_dotenv_is_read_when_the_email_is_sent(
    fake_smtp: type, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
) -> None:
    env = _write_env(
        tmp_path / ".env",
        "NOTIFY_GMAIL_USER=sender@gmail.com\nNOTIFY_GMAIL_APP_PASSWORD=oldpassword\n",
    )
    monkeypatch.setattr(notify, "_dotenv_path", lambda: env)
    with notify.notify_on_exit("exp"):
        # not exported at the start, so child processes of the run do not get it
        assert "NOTIFY_GMAIL_APP_PASSWORD" not in os.environ
        env.write_text(
            "NOTIFY_GMAIL_USER=sender@gmail.com\nNOTIFY_GMAIL_APP_PASSWORD=newpassword\n",
            encoding="utf-8",
        )
    (inst,) = fake_smtp.instances  # type: ignore[attr-defined]
    assert ("login", "sender@gmail.com", "newpassword") in inst.ops


def test_later_runs_in_the_same_process_see_dotenv_edits(
    fake_smtp: type, monkeypatch: pytest.MonkeyPatch, tmp_path: Path
) -> None:
    # e.g. `for cfg in sweep: with notify_on_exit(cfg): ...`
    text = "NOTIFY_GMAIL_USER=sender@gmail.com\nNOTIFY_GMAIL_APP_PASSWORD={}\n"
    env = _write_env(tmp_path / ".env", text.format("pw1"))
    monkeypatch.setattr(notify, "_dotenv_path", lambda: env)
    with notify.notify_on_exit("first"):
        pass
    env.write_text(text.format("pw2"), encoding="utf-8")
    with notify.notify_on_exit("second"):
        pass
    instances = fake_smtp.instances  # type: ignore[attr-defined]
    logins = [op[2] for inst in instances for op in inst.ops if op[0] == "login"]
    assert logins == ["pw1", "pw2"]
    assert "NOTIFY_GMAIL_APP_PASSWORD" not in os.environ


