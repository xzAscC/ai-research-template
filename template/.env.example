# Copy to .env (gitignored), run `chmod 600 .env` (notify ignores a .env that group or
# others can write), and fill in. Real environment variables win over .env.
# Gmail account that sends the notify_on_exit emails, and its app password.
NOTIFY_GMAIL_USER=
NOTIFY_GMAIL_APP_PASSWORD=
# Comma-separated recipients; empty means the sender.
NOTIFY_TO=
